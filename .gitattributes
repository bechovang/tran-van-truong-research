# Default: normalize text files to LF in the repo, auto-detect on checkout
* text=auto

# --- Source / text — force LF ---
*.py     text eol=lf
*.ipynb  text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf
*.toml   text eol=lf

# --- Windows-only scripts — keep CRLF ---
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# --- Binaries — never normalize ---
*.pdf          binary
*.xlsx         binary
*.xls          binary
*.zip          binary
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.pickle       binary
*.pt           binary
*.bin          binary
*.safetensors  binary
